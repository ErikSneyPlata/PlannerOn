generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
  SOMEDAY
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  INVESTMENT
  SUBSCRIPTION
}

enum EventCategory {
  WORK
  STUDY
  REST
  MEETING
  EXERCISE
  PERSONAL
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  tasks         Task[]
  habits        Habit[]
  transactions  Transaction[]
  agendaEvents  AgendaEvent[]
  focusSessions FocusSession[]
  logs          EventLog[]
  notes         Note[]
  settings      UserSettings?
  documentations ProjectDocumentation[]
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String?
  color          String?       @default("#4d8eff")
  priority       Priority      @default(NORMAL)
  status         ProjectStatus @default(ACTIVE)
  progress       Int           @default(0)
  healthScore    Float         @default(100)
  estimatedHours Float?
  actualHours    Float?
  budget         Float?
  revenue        Float?
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  documentations ProjectDocumentation[]
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  priority      Priority       @default(NORMAL)
  status        TaskStatus     @default(TODO)
  tags          String?        //  comma-separated tags
  estimatedTime Int?           // minutos
  actualTime    Int?           // minutos
  dueDate       DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  focusSessions FocusSession[]
}

model Habit {
  id          String   @id @default(cuid())
  title       String
  description String?
  frequency   String   @default("daily")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date      String   // ISO date string in YYYY-MM-DD format (e.g. "2026-05-27")
  completed Boolean  @default(true) // true = hecho, false = no hecho
  createdAt DateTime @default(now())
  @@unique([habitId, date])
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  category  String   @default("General")
  color     String   @default("#4d8eff")
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String          @id @default(cuid())
  title       String
  amount      Float
  type        TransactionType @default(EXPENSE)
  category    String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgendaEvent {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    EventCategory @default(PERSONAL)
  startDate   DateTime
  endDate     DateTime
  completed   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FocusSession {
  id        String   @id @default(cuid())
  duration  Int
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}

model UserSettings {
  id                String   @id @default(cuid())
  theme             String   @default("dark")
  language          String   @default("es")
  timezone          String   @default("America/Bogota")
  notifications     Boolean  @default(true)
  analytics         Boolean  @default(true)
  crossDeviceSync   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProjectDocumentation {
  id          String   @id @default(cuid())
  title       String
  content     String   // Markdown-based development/architecture documentation
  category    String   // 'DEVELOPMENT' | 'ARCHITECTURE' | 'DESIGN' | 'DATABASE' | 'OTHER'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
